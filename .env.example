# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.local' to configure your live services:
# cp .env.example .env.local
#
# NOTE: If no Supabase credentials are configured, the application automatically
# boots in "Zero-Configuration Demo Mode" with localStorage persistence.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME MODE
# ------------------------------------------------------------------------------
# Canonical public URL of your application (used for Auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicitly force mock demo mode even if Supabase keys exist (true / false)
NEXT_PUBLIC_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database & Authentication)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
